{
  "name": "advokat-vladic",
  "private": true,
  "license": "UNLICENSED",
  "author": "Miloš Milinkov (https://github.com/MiloshMilinkov)",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "typecheck": "vue-tsc -b",
    "db:seed:build": "node scripts/build-seed.mjs",
    "db:migrate:local": "wrangler d1 migrations apply advokat-vladic --local",
    "db:seed:local": "wrangler d1 execute advokat-vladic --local --file seed/seed.sql",
    "db:setup:local": "npm run db:seed:build && npm run db:migrate:local && npm run db:seed:local",
    "db:migrate:remote": "wrangler d1 migrations apply advokat-vladic --remote",
    "db:seed:remote": "wrangler d1 execute advokat-vladic --remote --file seed/seed.sql",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "marked": "^18.1.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/workers-types": "^5.20261106.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.158.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261101.1": true,
    "workerd@1.20261104.1": true
  }
}
